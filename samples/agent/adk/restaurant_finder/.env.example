# Copy this file to .env and fill in your OpenAI API key.
# Create a key at: https://platform.openai.com/api-keys

OPENAI_API_KEY=your_openai_api_key_here
LITELLM_MODEL=openai/gpt-5.6-luna
# Chat Completions requires this when the agent uses function tools.
OPENAI_REASONING_EFFORT=none

# Optional: Override the persistent A2A/A2UI log path. Relative paths are
# resolved from this sample directory. The default is logs/a2ui.log.
# A2UI_LOG_FILE=logs/a2ui.log

# Optional: Use Gemini through LiteLLM instead.
# LITELLM_MODEL=gemini/gemini-3.8-flash
# GEMINI_API_KEY=your_gemini_api_key_here
#
# Optional: Use Vertex AI for a Gemini model instead of a Gemini API key.
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
